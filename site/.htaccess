# HTTPS obligatoire, et www renvoyé vers l'adresse sans www
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://jeanferretpaysage.fr/$1 [L,R=301]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://jeanferretpaysage.fr/$1 [L,R=301]
# /index.html et /dossier/index.html renvoyés vers l'adresse propre (évite les doublons)
RewriteCond %{THE_REQUEST} \s/+((?:[^\s?]*/)?)index\.html[\s?]
RewriteRule ^ https://jeanferretpaysage.fr/%1 [L,R=301]


# Cache navigateur
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/x-icon "access plus 6 months"
  ExpiresByType image/vnd.microsoft.icon "access plus 6 months"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/xml
</IfModule>
